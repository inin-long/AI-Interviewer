<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inin.aiinterviewer.ui.controller.KnowledgeController"
      spacing="18" styleClass="page-content">
    <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="知识库" styleClass="page-title"/>
            <Label text="上传文档后自动解析、切片并建立用户私有向量索引" styleClass="secondary-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text="共 0 个文档" styleClass="secondary-text"/>
        <Button text="刷新" onAction="#refresh" styleClass="secondary-button"/>
        <Button fx:id="uploadButton" text="上传文档" onAction="#upload" styleClass="primary-button"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS" styleClass="workspace-split">
        <items>
            <VBox spacing="12" styleClass="content-card">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <TableView fx:id="documentTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <placeholder><Label text="暂无知识文档" styleClass="secondary-text"/></placeholder>
                    <columns>
                        <TableColumn fx:id="nameColumn" text="文档名称" prefWidth="300"/>
                        <TableColumn fx:id="categoryColumn" text="分类" prefWidth="140"/>
                        <TableColumn fx:id="typeColumn" text="类型" prefWidth="90"/>
                        <TableColumn fx:id="statusColumn" text="索引状态" prefWidth="130"/>
                        <TableColumn fx:id="sizeColumn" text="大小" prefWidth="110"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="deleteButton" text="删除" onAction="#deleteSelected" styleClass="danger-button"/>
                    <Button fx:id="viewButton" text="查看详情" onAction="#viewSelected" styleClass="secondary-button"/>
                </HBox>
            </VBox>
            <VBox spacing="12" styleClass="content-card">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="语义检索验证" styleClass="module-title"/>
                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="输入问题或技术关键词" HBox.hgrow="ALWAYS"/>
                    <Button text="检索" onAction="#search" styleClass="primary-button"/>
                </HBox>
                <TextArea fx:id="searchResultArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          promptText="检索结果将显示在这里"/>
            </VBox>
        </items>
    </SplitPane>
</VBox>
