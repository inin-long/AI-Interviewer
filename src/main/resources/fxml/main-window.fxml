<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.MainWindowController"
            fx:id="mainRoot"
            styleClass="app-root">
    <left>
        <VBox fx:id="sidebar" minWidth="232" prefWidth="232" maxWidth="232" spacing="6" styleClass="sidebar">
            <padding><Insets top="26" right="12" bottom="18" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-brand">
                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/home/app-icon.png"/></image>
                </ImageView>
                <Label text="AI Interviewer" styleClass="window-brand"/>
            </HBox>
            <Region prefHeight="22"/>
            <Button fx:id="dashboardNavButton" text="首页" onAction="#showDashboard"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2h-home-outline" iconSize="21"/></graphic>
            </Button>
            <Button fx:id="plansNavButton" text="面试方案" onAction="#showPlans"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2f-file-document-edit-outline" iconSize="21"/></graphic>
            </Button>
            <Button fx:id="historyNavButton" text="面试记录" onAction="#showHistory"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2c-calendar-clock-outline" iconSize="21"/></graphic>
            </Button>
            <Button fx:id="resumesNavButton" text="简历" onAction="#showResumes"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2f-file-account-outline" iconSize="21"/></graphic>
            </Button>
            <Button fx:id="knowledgeNavButton" text="知识库" onAction="#showKnowledge"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2b-book-open-variant" iconSize="21"/></graphic>
            </Button>
            <Button fx:id="settingsNavButton" text="设置" onAction="#showSettings"
                    contentDisplay="LEFT" graphicTextGap="15" maxWidth="Infinity" styleClass="nav-button">
                <graphic><FontIcon iconLiteral="mdi2c-cog-outline" iconSize="21"/></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <StackPane fx:id="resumeSidebarArtwork" visible="false" managed="false"
                       minHeight="188" prefHeight="188" styleClass="resume-sidebar-artwork">
                <ImageView fitWidth="178" fitHeight="178" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/resume/resume-sidebar-illustration.png"/></image>
                </ImageView>
            </StackPane>
            <Separator styleClass="sidebar-divider"/>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-service-row">
                <FontIcon fx:id="aiStatusIcon" iconLiteral="mdi2c-circle" iconSize="10" styleClass="service-status-icon"/>
                <Label fx:id="aiStatusLabel" text="AI 服务状态：正常" styleClass="sidebar-status-text"/>
            </HBox>
            <Label text="版本 0.1.0" styleClass="fine-print sidebar-version"/>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <VBox>
                    <HBox minHeight="62" prefHeight="62" alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
                        <padding><Insets top="0" right="28" bottom="0" left="30"/></padding>
                        <FontIcon iconLiteral="mdi2m-menu" iconSize="22" styleClass="topbar-menu-icon"/>
                        <Label fx:id="contentTitleLabel" text="首页" styleClass="topbar-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="userMenuButton" onAction="#showUserMenu" styleClass="user-menu-button">
                            <graphic>
                                <HBox alignment="CENTER" spacing="9">
                                    <Label fx:id="avatarLabel" text="M" styleClass="user-avatar"/>
                                    <Label fx:id="usernameLabel" text="用户" styleClass="username-text"/>
                                    <FontIcon iconLiteral="mdi2c-chevron-down" iconSize="17" styleClass="user-chevron"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <HBox fx:id="activityReceipt" alignment="CENTER_LEFT" spacing="14"
                          visible="false" managed="false" styleClass="activity-receipt">
                        <padding><Insets top="10" right="24" bottom="10" left="28"/></padding>
                        <Label text="后台回执" styleClass="activity-receipt-kicker"/>
                        <VBox spacing="2">
                            <Label fx:id="activityTitleLabel" text="任务已完成" styleClass="activity-receipt-title"/>
                            <Label fx:id="activityDetailLabel" text="结果已保存" styleClass="activity-receipt-detail"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="查看任务" onAction="#showNotificationTask" styleClass="activity-receipt-action"/>
                        <Button text="×" onAction="#dismissActivityReceipt" styleClass="activity-receipt-close"
                                accessibleText="关闭任务回执"/>
                    </HBox>
                </VBox>
            </top>
            <center>
                <StackPane fx:id="contentHost" styleClass="content-host"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
