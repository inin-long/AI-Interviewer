<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.MainWindowController"
            fx:id="mainRoot"
            styleClass="app-root">
    <left>
        <VBox fx:id="sidebar" prefWidth="216" spacing="6" styleClass="sidebar">
            <padding><Insets top="22" right="14" bottom="18" left="14"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-brand">
                <Label text="AI" styleClass="brand-mark-small"/>
                <Label text="AI Interviewer" styleClass="window-brand"/>
            </HBox>
            <Region prefHeight="24"/>
            <Button fx:id="dashboardNavButton" text="首页" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="plansNavButton" text="面试方案" onAction="#showPlans" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="historyNavButton" text="面试记录" onAction="#showHistory" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="resumesNavButton" text="简历" onAction="#showResumes" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="profilesNavButton" text="候选人画像" onAction="#showProfiles" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="knowledgeNavButton" text="知识库" onAction="#showKnowledge" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="tasksNavButton" text="任务中心" onAction="#showTasks" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="settingsNavButton" text="设置" onAction="#showSettings" maxWidth="Infinity" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="aiStatusLabel" text="AI 尚未配置" styleClass="sidebar-status" wrapText="true"/>
            <Label text="版本 0.1.0" styleClass="fine-print"/>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <VBox>
                    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
                        <padding><Insets top="12" right="24" bottom="12" left="28"/></padding>
                        <Label fx:id="contentTitleLabel" text="首页" styleClass="topbar-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="taskStatusButton" text="后台任务" onAction="#showTasks"
                                styleClass="task-status-button" accessibleText="打开任务中心"/>
                        <Label fx:id="usernameLabel" text="用户" styleClass="user-chip"/>
                        <Button text="退出" onAction="#logout" styleClass="text-button"/>
                    </HBox>
                    <HBox fx:id="activityReceipt" alignment="CENTER_LEFT" spacing="14"
                          visible="false" managed="false" styleClass="activity-receipt">
                        <padding><Insets top="10" right="24" bottom="10" left="28"/></padding>
                        <Label text="后台回执" styleClass="activity-receipt-kicker"/>
                        <VBox spacing="2">
                            <Label fx:id="activityTitleLabel" text="任务已完成" styleClass="activity-receipt-title"/>
                            <Label fx:id="activityDetailLabel" text="结果已保存" styleClass="activity-receipt-detail"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="查看任务" onAction="#showNotificationTask" styleClass="activity-receipt-action"/>
                        <Button text="×" onAction="#dismissActivityReceipt" styleClass="activity-receipt-close"
                                accessibleText="关闭任务回执"/>
                    </HBox>
                </VBox>
            </top>
            <center>
                <StackPane fx:id="contentHost" styleClass="content-host"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
