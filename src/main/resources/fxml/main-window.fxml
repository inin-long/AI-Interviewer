<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.MainWindowController"
            styleClass="app-root">
    <left>
        <VBox prefWidth="216" spacing="6" styleClass="sidebar">
            <padding><Insets top="22" right="14" bottom="18" left="14"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-brand">
                <Label text="AI" styleClass="brand-mark-small"/>
                <Label text="AI Interviewer" styleClass="window-brand"/>
            </HBox>
            <Region prefHeight="24"/>
            <Button text="首页" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="面试方案" onAction="#showPlans" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="面试记录" onAction="#showHistory" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="简历" onAction="#showResumes" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="知识库" onAction="#showKnowledge" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="设置" onAction="#showSettings" maxWidth="Infinity" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="aiStatusLabel" text="AI 尚未配置" styleClass="sidebar-status" wrapText="true"/>
            <Label text="版本 0.1.0" styleClass="fine-print"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding><Insets top="12" right="24" bottom="12" left="28"/></padding>
            <Label fx:id="contentTitleLabel" text="首页" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="usernameLabel" text="用户" styleClass="user-chip"/>
            <Button text="退出" onAction="#logout" styleClass="text-button"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentHost" styleClass="content-host"/>
    </center>
</BorderPane>

