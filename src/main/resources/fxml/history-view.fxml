<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.inin.aiinterviewer.ui.component.AppSelect?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inin.aiinterviewer.ui.controller.InterviewHistoryController"
      spacing="18" styleClass="page-content">
    <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="面试记录" styleClass="page-title"/>
            <Label text="查看历史模拟面试，继续未完成会话，并从记录进入正式评估报告" styleClass="secondary-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text="共 0 条记录" styleClass="secondary-text"/>
        <Button text="开始新面试" onAction="#createInterview" styleClass="primary-button"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="content-card history-filter-bar">
        <TextField fx:id="searchField" promptText="搜索面试标题或岗位" HBox.hgrow="ALWAYS"/>
        <AppSelect fx:id="statusBox" prefWidth="150" onAction="#refresh"/>
        <Button text="搜索" onAction="#refresh" styleClass="secondary-button"/>
        <Button text="清除" onAction="#clearFilters" styleClass="text-button"/>
    </HBox>
    <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="content-card">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <placeholder><Label text="暂无面试记录，请先从面试方案开始一次模拟面试" styleClass="secondary-text"/></placeholder>
            <columns>
                <TableColumn fx:id="titleColumn" text="面试标题" prefWidth="260"/>
                <TableColumn fx:id="jobColumn" text="目标岗位" prefWidth="210"/>
                <TableColumn fx:id="statusColumn" text="状态" prefWidth="105"/>
                <TableColumn fx:id="durationColumn" text="用时" prefWidth="105"/>
                <TableColumn fx:id="scoreColumn" text="评分" prefWidth="90"/>
                <TableColumn fx:id="updatedColumn" text="最近更新" prefWidth="170"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button text="刷新" onAction="#refresh" styleClass="text-button"/>
            <Button fx:id="continueButton" text="继续面试" onAction="#continueInterview"
                    disable="true" styleClass="secondary-button"/>
            <Button fx:id="detailButton" text="查看记录" onAction="#openDetail" styleClass="secondary-button"/>
            <Button fx:id="reportButton" text="查看报告" onAction="#openReport"
                    disable="true" styleClass="primary-button"/>
            <Button fx:id="deleteButton" text="删除记录" onAction="#deleteRecord"
                    disable="true" styleClass="danger-button"/>
        </HBox>
    </VBox>
</VBox>
