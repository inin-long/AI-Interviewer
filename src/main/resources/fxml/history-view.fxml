<?xml version="1.0" encoding="UTF-8"?>

<?import com.inin.aiinterviewer.ui.component.AppSelect?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inin.aiinterviewer.ui.controller.InterviewHistoryController"
      spacing="16" styleClass="history-page">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="面试记录" styleClass="history-page-title"/>
            <Label text="查看历史模拟面试、继续未完成会话，并从记录进入正式评估报告"
                   styleClass="history-page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="开始新面试" onAction="#createInterview" styleClass="primary-button,history-primary-action">
            <graphic><FontIcon iconLiteral="mdi2p-play-circle-outline" iconSize="18"/></graphic>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="content-card history-filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS" styleClass="history-search-wrap">
            <FontIcon iconLiteral="mdi2m-magnify" iconSize="18" styleClass="history-search-icon"/>
            <TextField fx:id="searchField" promptText="搜索面试标题、岗位或标签"
                       HBox.hgrow="ALWAYS" styleClass="history-search-field"/>
        </HBox>
        <AppSelect fx:id="statusBox" prefWidth="138" styleClass="history-filter-select"/>
        <Button text="选择日期范围" styleClass="history-range-button,secondary-button">
            <graphic><FontIcon iconLiteral="mdi2c-calendar-range-outline" iconSize="17"/></graphic>
        </Button>
        <AppSelect fx:id="sortBox" prefWidth="150" styleClass="history-sort-select"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="history-list-panel">
            <padding><Insets top="14" right="14" bottom="12" left="14"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="全部记录" styleClass="history-section-title"/>
                <Label fx:id="summaryLabel" text="（0）" styleClass="history-count-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#refresh" accessibleText="刷新记录" styleClass="history-icon-button">
                    <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="刷新记录"/></tooltip>
                </Button>
            </HBox>
            <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="history-list">
                <placeholder>
                    <VBox spacing="9" alignment="CENTER">
                        <FontIcon iconLiteral="mdi2c-calendar-blank-outline" iconSize="38"
                                  styleClass="history-empty-icon"/>
                        <Label text="暂无面试记录" styleClass="history-empty-title"/>
                        <Label text="创建方案并开始模拟面试后，所有会话都会在这里沉淀"
                               styleClass="history-empty-copy"/>
                    </VBox>
                </placeholder>
            </ListView>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="footerCountLabel" text="共 0 条" styleClass="history-footer-count"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="6" styleClass="history-pagination">
                    <Button styleClass="history-page-nav">
                        <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="16"/></graphic>
                    </Button>
                    <Button text="1" styleClass="history-page-number,active"/>
                    <Button text="2" styleClass="history-page-number"/>
                    <Button text="3" styleClass="history-page-number"/>
                    <Label text="…" styleClass="history-page-ellipsis"/>
                    <Button text="5" styleClass="history-page-number"/>
                    <Button styleClass="history-page-nav">
                        <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="16"/></graphic>
                    </Button>
                </HBox>
                <AppSelect fx:id="pageSizeBox" prefWidth="110" styleClass="history-page-size-select"/>
            </HBox>
        </VBox>

        <VBox spacing="10" minWidth="320" prefWidth="340" maxWidth="380">
            <VBox spacing="10" styleClass="history-side-card">
                <padding><Insets top="15" right="16" bottom="15" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="mdi2c-clipboard-text-outline" iconSize="18"
                              styleClass="history-side-icon"/>
                    <Label text="记录详情" styleClass="history-section-title"/>
                </HBox>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="74" prefWidth="74"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="面试标题：" styleClass="history-detail-key" GridPane.rowIndex="0"/>
                    <Label fx:id="detailTitleLabel" text="—" wrapText="true" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="面向岗位：" styleClass="history-detail-key" GridPane.rowIndex="1"/>
                    <Label fx:id="detailJobLabel" text="—" wrapText="true" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="当前状态：" styleClass="history-detail-key" GridPane.rowIndex="2"/>
                    <Label fx:id="detailStatusLabel" text="—" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="开始时间：" styleClass="history-detail-key" GridPane.rowIndex="3"/>
                    <Label fx:id="detailStartLabel" text="—" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="结束时间：" styleClass="history-detail-key" GridPane.rowIndex="4"/>
                    <Label fx:id="detailEndLabel" text="—" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="总时长：" styleClass="history-detail-key" GridPane.rowIndex="5"/>
                    <Label fx:id="detailDurationLabel" text="—" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <Label text="关联简历：" styleClass="history-detail-key" GridPane.rowIndex="6"/>
                    <Label fx:id="detailResumeLabel" text="—" wrapText="true" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    <Label text="最终评分：" styleClass="history-detail-key" GridPane.rowIndex="7"/>
                    <Label fx:id="detailScoreLabel" text="—" styleClass="history-detail-value,history-score-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    <Label text="报告状态：" styleClass="history-detail-key" GridPane.rowIndex="8"/>
                    <Label fx:id="detailReportLabel" text="—" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    <Label text="面试阶段：" styleClass="history-detail-key" GridPane.rowIndex="9"/>
                    <Label fx:id="detailStagesLabel" text="—" wrapText="true" styleClass="history-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                </GridPane>
                <Separator/>
                <Label text="面试摘要" styleClass="history-section-subtitle"/>
                <Label fx:id="detailSummaryLabel"
                       text="请选择一条记录以查看摘要"
                       wrapText="true" styleClass="history-summary-text"/>
                <HBox spacing="10">
                    <Button fx:id="reportDetailButton" text="查看完整报告" onAction="#openReport"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="primary-button,history-detail-primary">
                        <graphic><FontIcon iconLiteral="mdi2f-file-document-outline" iconSize="16"/></graphic>
                    </Button>
                    <Button fx:id="continueDialogButton" text="继续查看对话" onAction="#openDetail"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="history-detail-outline">
                        <graphic><FontIcon iconLiteral="mdi2c-comment-text-outline" iconSize="16"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <VBox spacing="10" styleClass="history-side-card">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="mdi2f-filter-variant" iconSize="18" styleClass="history-side-icon"/>
                    <Label text="快速筛选" styleClass="history-section-title"/>
                </HBox>
                <FlowPane fx:id="quickFilterPane" hgap="8" vgap="8" styleClass="history-quick-filter-pane"/>
            </VBox>

            <VBox spacing="10" styleClass="history-side-card">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="mdi2c-chart-box-outline" iconSize="18" styleClass="history-side-icon"/>
                    <Label text="历史概览" styleClass="history-section-title"/>
                </HBox>
                <HBox spacing="8">
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" styleClass="history-metric-box">
                        <Label text="本周面试" styleClass="history-metric-label"/>
                        <Label fx:id="weeklyCountLabel" text="0 次" styleClass="history-metric-value"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" styleClass="history-metric-box">
                        <Label text="平均得分" styleClass="history-metric-label"/>
                        <Label fx:id="averageScoreLabel" text="—" styleClass="history-metric-value,history-score-accent"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" styleClass="history-metric-box">
                        <Label text="完成率" styleClass="history-metric-label"/>
                        <Label fx:id="completionLabel" text="0%" styleClass="history-metric-value,history-completion-accent"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" styleClass="history-metric-box">
                        <Label text="最近一次" styleClass="history-metric-label"/>
                        <Label fx:id="latestLabel" text="—" styleClass="history-metric-value"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
