<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inin.aiinterviewer.ui.controller.InterviewPlanController"
      spacing="18" styleClass="page-content">
    <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="面试方案" styleClass="page-title"/>
            <Label text="保存常用岗位、简历和面试规则；双击列表可进入独立编辑页" styleClass="secondary-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text="共 0 个可复用方案" styleClass="secondary-text"/>
        <Button text="刷新" onAction="#refresh" styleClass="secondary-button"/>
        <Button text="新建方案" onAction="#createPlan" styleClass="primary-button"/>
    </HBox>
    <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="content-card">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
        <TableView fx:id="planTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <placeholder><Label text="暂无方案，点击右上角创建" styleClass="secondary-text"/></placeholder>
            <columns>
                <TableColumn fx:id="planNameColumn" text="方案名称" prefWidth="250"/>
                <TableColumn fx:id="jobColumn" text="目标岗位" prefWidth="220"/>
                <TableColumn fx:id="difficultyColumn" text="难度" prefWidth="100"/>
                <TableColumn fx:id="durationColumn" text="时长（分钟）" prefWidth="120"/>
                <TableColumn fx:id="questionColumn" text="题目数量" prefWidth="110"/>
                <TableColumn fx:id="updatedColumn" text="更新时间" prefWidth="170"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="duplicateButton" text="复制所选" onAction="#duplicateSelected" styleClass="secondary-button"/>
            <Button fx:id="deleteButton" text="删除所选" onAction="#deleteSelected" styleClass="danger-button"/>
            <Button fx:id="editButton" text="查看 / 编辑" onAction="#editSelected" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>

