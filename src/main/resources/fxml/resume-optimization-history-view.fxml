<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inin.aiinterviewer.ui.controller.ResumeOptimizationHistoryController"
      spacing="12" styleClass="container">

    <padding>
        <Insets topRightBottomLeft="20"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="&lt; 返回" onAction="#handleBack" styleClass="btn-secondary"/>
        <Label text="简历优化历史" styleClass="heading-2"/>
    </HBox>

    <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="card"/>

</VBox>
