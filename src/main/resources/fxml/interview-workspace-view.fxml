<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.inin.aiinterviewer.ui.component.InterviewTranscriptView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.InterviewWorkspaceController"
            styleClass="page-content">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="subpage-header">
            <padding><Insets top="20" right="28" bottom="18" left="28"/></padding>
            <Button text="←" onAction="#back" styleClass="back-icon-button"
                    accessibleText="返回面试方案列表">
                <tooltip><Tooltip text="暂停并返回方案列表"/></tooltip>
            </Button>
            <VBox spacing="4">
                <Label fx:id="titleLabel" text="模拟面试" styleClass="page-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="jobLabel" text="目标岗位" styleClass="secondary-text"/>
                    <Label fx:id="stageLabel" text="开场介绍" styleClass="status-tag"/>
                    <Label fx:id="statusLabel" text="进行中" styleClass="status-tag"/>
                    <Label fx:id="progressLabel" text="第 0 / 0 题" styleClass="secondary-text"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="retryQuestionButton" text="生成问题" onAction="#generateInitialQuestion"
                    styleClass="secondary-button" visible="false" managed="false"/>
            <Button fx:id="reportButton" text="查看报告" onAction="#openReport"
                    styleClass="primary-button" visible="false" managed="false"/>
            <Button fx:id="pauseButton" text="暂停面试" onAction="#togglePause" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" styleClass="interview-workspace">
            <padding><Insets top="20" right="28" bottom="28" left="28"/></padding>
            <Label fx:id="aiNoticeLabel" text="AI 状态" styleClass="local-data-note" wrapText="true"/>
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="content-card">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="面试对话" styleClass="module-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="回答、阶段切换和暂停均会保存" styleClass="secondary-text"/>
                    </HBox>
                    <InterviewTranscriptView fx:id="transcriptView" VBox.vgrow="ALWAYS"/>
                    <Separator/>
                    <Label text="你的回答" styleClass="field-label"/>
                    <TextArea fx:id="answerArea" promptText="输入你的回答，AI 将结合当前阶段和已关联资料继续提问"
                              wrapText="true" prefRowCount="4"/>
                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="submitButton" text="提交回答" onAction="#submitAnswer"
                                defaultButton="true" styleClass="primary-button"/>
                    </HBox>
                </VBox>
                <VBox fx:id="citationRail" spacing="12" minWidth="270" prefWidth="300" maxWidth="330"
                      styleClass="content-card,citation-rail">
                    <padding><Insets top="20" right="18" bottom="18" left="18"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="3">
                            <Label text="参考依据" styleClass="module-title"/>
                            <Label text="本次提问实际采用的片段" styleClass="secondary-text"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="citationCountLabel" text="暂无引用" styleClass="citation-count"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                styleClass="citation-scroll">
                        <content>
                            <VBox fx:id="citationContainer" spacing="10" fillWidth="true"/>
                        </content>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
