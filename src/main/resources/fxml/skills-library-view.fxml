<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.inin.aiinterviewer.ui.component.AppSelect?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inin.aiinterviewer.ui.controller.SkillsLibraryController"
      spacing="12" styleClass="container">

    <padding>
        <Insets topRightBottomLeft="20"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="面试技巧库" styleClass="heading-2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <AppSelect fx:id="categoryFilter" promptText="分类筛选" prefWidth="140"/>
        <Button text="新增文章" onAction="#handleAdd" styleClass="btn-primary"/>
    </HBox>

    <ListView fx:id="articleList" VBox.vgrow="ALWAYS" styleClass="card">
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <padding><Insets topRightBottomLeft="30"/></padding>
                <Label text="📚" style="-fx-font-size: 32px;"/>
                <Label text="暂无面试技巧文章" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                <Label text="点击「新增文章」添加面试技巧资料" style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
            </VBox>
        </placeholder>
    </ListView>

</VBox>
