<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.inin.aiinterviewer.ui.component.MarkdownView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.InterviewReportController"
            styleClass="page-content">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="subpage-header">
            <padding><Insets top="20" right="28" bottom="18" left="28"/></padding>
            <Button text="←" onAction="#back" styleClass="back-icon-button" accessibleText="返回面试">
                <tooltip><Tooltip text="返回面试"/></tooltip>
            </Button>
            <VBox spacing="4">
                <Label fx:id="titleLabel" text="面试报告" styleClass="page-title"/>
                <Label text="评分与报告均基于本次已保存问答" styleClass="secondary-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="查看本次问答" onAction="#openTranscript" styleClass="secondary-button"/>
            <Button text="复制 Markdown" onAction="#copyMarkdown" styleClass="secondary-button"/>
            <Button text="导出 .md" onAction="#exportMarkdown" styleClass="primary-button"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="20" styleClass="editor-page">
            <padding><Insets top="20" right="28" bottom="28" left="28"/></padding>
            <VBox spacing="14" prefWidth="300" minWidth="280" styleClass="content-card report-directory">
                <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                <Label text="报告目录" styleClass="module-title"/>
                <Button text="报告首页" onAction="#scrollHome" maxWidth="Infinity" styleClass="report-directory-button"/>
                <Button text="能力评分" onAction="#scrollScores" maxWidth="Infinity" styleClass="report-directory-button"/>
                <Button text="综合评价" onAction="#scrollSummary" maxWidth="Infinity" styleClass="report-directory-button"/>
                <Button text="问答摘要" onAction="#scrollTranscriptSummary" maxWidth="Infinity" styleClass="report-directory-button"/>
                <Button fx:id="sourceDirectoryButton" text="参考依据" onAction="#scrollSources"
                        maxWidth="Infinity" styleClass="report-directory-button"/>
                <Separator/>
                <Label text="综合得分" styleClass="summary-label"/>
                <Label fx:id="overallScoreLabel" text="0 / 100" styleClass="report-score"/>
                <Separator/>
                <GridPane hgap="18" vgap="14">
                    <Label text="技术基础" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="technicalScoreLabel" text="0 分" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="summary-value"/>
                    <Label text="问题解决" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="problemSolvingScoreLabel" text="0 分" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-value"/>
                    <Label text="项目经验" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="projectScoreLabel" text="0 分" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="summary-value"/>
                    <Label text="系统设计" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="systemDesignScoreLabel" text="0 分" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="summary-value"/>
                    <Label text="沟通表达" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="communicationScoreLabel" text="0 分" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="summary-value"/>
                    <Label text="综合能力" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="summary-label"/>
                    <Label fx:id="comprehensiveScoreLabel" text="0 分" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="summary-value"/>
                </GridPane>
                <Separator/>
                <Label text="评分证据定位" styleClass="summary-label"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="150" maxHeight="190"
                            VBox.vgrow="ALWAYS" styleClass="report-citation-scroll">
                    <content>
                        <VBox fx:id="evidenceNavigationContainer" spacing="6" fillWidth="true"/>
                    </content>
                </ScrollPane>
                <Separator/>
                <Label text="分支复盘" styleClass="summary-label"/>
                <VBox fx:id="branchNavigationContainer" spacing="6" fillWidth="true"/>
                <Separator/>
                <Label text="专项训练建议" styleClass="summary-label"/>
                <VBox fx:id="trainingRecommendationContainer" spacing="5" fillWidth="true"/>
                <Button fx:id="trainingPlanButton" text="创建专项训练方案" onAction="#createTrainingPlan"
                        maxWidth="Infinity" styleClass="primary-button"/>
                <Separator/>
                <Label text="引用定位" styleClass="summary-label"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="130" maxHeight="160"
                            VBox.vgrow="ALWAYS" styleClass="report-citation-scroll">
                    <content>
                        <VBox fx:id="citationNavigationContainer" spacing="6" fillWidth="true"/>
                    </content>
                </ScrollPane>
            </VBox>
            <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="content-card report-document">
                <MarkdownView fx:id="reportView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
