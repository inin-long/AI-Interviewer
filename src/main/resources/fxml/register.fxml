<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.RegisterController"
            styleClass="auth-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="window-header">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="AI" styleClass="brand-mark-small"/>
            <Label text="AI Interviewer" styleClass="window-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="●  本地模式" styleClass="status-success"/>
        </HBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="64" styleClass="auth-content">
            <padding><Insets top="32" right="64" bottom="32" left="64"/></padding>
            <VBox spacing="22" prefWidth="560" maxWidth="620" styleClass="auth-intro">
                <HBox alignment="CENTER_LEFT" spacing="18">
                    <Label text="AI" styleClass="brand-mark-large"/>
                    <VBox spacing="3">
                        <Label text="AI Interviewer" styleClass="brand-title"/>
                        <Label text="本地 AI 技术面试助手" styleClass="secondary-text"/>
                    </VBox>
                </HBox>
                <Region prefHeight="18"/>
                <Label text="创建你的本地训练空间" styleClass="hero-title" wrapText="true"/>
                <Label text="不同账户的简历、知识库、面试记录和报告彼此隔离。"
                       styleClass="hero-subtitle" wrapText="true"/>
                <VBox spacing="16">
                    <Label text="• 密码使用 BCrypt 单向哈希保存" styleClass="feature-title"/>
                    <Label text="• 用户文件按账户目录隔离" styleClass="feature-title"/>
                    <Label text="• 无云端账号、邮箱验证或数据同步" styleClass="feature-title"/>
                </VBox>
                <Region prefHeight="20"/>
                <Label text="数据安全 · 创建的是本地账户，不会上传到云端。"
                       styleClass="local-data-note" wrapText="true"/>
            </VBox>
            <VBox spacing="13" prefWidth="440" maxWidth="460" styleClass="form-card">
                <Label text="创建账户" styleClass="form-title"/>
                <Label text="用户名支持字母、数字、点、横线和下划线" styleClass="secondary-text"/>
                <Label text="用户名" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="3～64 个字符"/>
                <Label text="昵称" styleClass="field-label"/>
                <TextField fx:id="nicknameField" promptText="界面中显示的称呼，可留空"/>
                <Label text="密码" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="至少 8 个字符"/>
                <Label text="确认密码" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="请再次输入密码" onAction="#handleRegister"/>
                <CheckBox fx:id="agreementCheckBox" text="我已阅读并同意本地使用说明"/>
                <Label fx:id="errorLabel" wrapText="true" styleClass="form-error"/>
                <Button text="创建账户" onAction="#handleRegister" defaultButton="true"
                        maxWidth="Infinity" styleClass="primary-button"/>
                <Button text="返回登录" onAction="#showLogin"
                        maxWidth="Infinity" styleClass="secondary-button"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

