<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.LoginController"
            styleClass="auth-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="window-header">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="AI" styleClass="brand-mark-small"/>
            <Label text="AI Interviewer" styleClass="window-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="●  本地模式" styleClass="status-success"/>
        </HBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="64" styleClass="auth-content">
            <padding><Insets top="44" right="64" bottom="44" left="64"/></padding>
            <VBox spacing="24" prefWidth="560" maxWidth="620" styleClass="auth-intro">
                <HBox alignment="CENTER_LEFT" spacing="18">
                    <Label text="AI" styleClass="brand-mark-large"/>
                    <VBox spacing="3">
                        <Label text="AI Interviewer" styleClass="brand-title"/>
                        <Label text="本地 AI 技术面试助手" styleClass="secondary-text"/>
                    </VBox>
                </HBox>
                <Region prefHeight="20"/>
                <Label text="开始你的 AI 模拟面试" styleClass="hero-title"/>
                <Label text="简历解析 · 智能提问 · 深入追问 · 评估反馈 · 报告生成"
                       styleClass="hero-subtitle" wrapText="true"/>
                <Region prefHeight="8"/>
                <VBox spacing="18">
                    <VBox spacing="4" styleClass="feature-row">
                        <Label text="理解你的简历与项目经验" styleClass="feature-title"/>
                        <Label text="本地解析简历与技能画像，为面试建立可靠上下文" styleClass="secondary-text"/>
                    </VBox>
                    <VBox spacing="4" styleClass="feature-row">
                        <Label text="生成有依据的个性化问题" styleClass="feature-title"/>
                        <Label text="结合岗位、技术栈和项目经历进行提问与追问" styleClass="secondary-text"/>
                    </VBox>
                    <VBox spacing="4" styleClass="feature-row">
                        <Label text="形成结构化评估报告" styleClass="feature-title"/>
                        <Label text="从多个维度分析表现，并给出可执行的改进建议" styleClass="secondary-text"/>
                    </VBox>
                </VBox>
                <Region prefHeight="10"/>
                <Label text="数据安全 · 账户和业务数据默认保存在本机"
                       styleClass="local-data-note" wrapText="true"/>
            </VBox>
            <VBox spacing="18" prefWidth="440" maxWidth="460" styleClass="form-card">
                <Label text="登录账户" styleClass="form-title"/>
                <Label text="欢迎回来，请登录你的本地账户" styleClass="secondary-text"/>
                <Region prefHeight="8"/>
                <Label text="用户名" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="请输入用户名" onAction="#handleLogin"/>
                <Label text="密码" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="请输入密码" onAction="#handleLogin"/>
                <Label fx:id="errorLabel" wrapText="true" styleClass="form-error"/>
                <Button text="登录" onAction="#handleLogin" defaultButton="true"
                        maxWidth="Infinity" styleClass="primary-button"/>
                <Separator/>
                <Button text="创建本地账户" onAction="#showRegister"
                        maxWidth="Infinity" styleClass="secondary-button"/>
                <Label text="所有数据仅保存在本机；AI 调用需要单独配置服务。"
                       styleClass="fine-print" wrapText="true"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

