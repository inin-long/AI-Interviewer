<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.LoginController"
            styleClass="auth-root, auth-screen">
    <top>
        <Region minHeight="28" prefHeight="28" maxHeight="28"/>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="0" styleClass="auth-main">
            <padding><Insets right="72" left="72"/></padding>
            <Region minWidth="36" prefWidth="36" maxWidth="160" HBox.hgrow="ALWAYS"/>
            <fx:include fx:id="authShowcase" source="auth-showcase.fxml"/>
            <Region minWidth="36" prefWidth="36" maxWidth="36"/>

            <VBox minWidth="440" prefWidth="440" maxWidth="440"
                  minHeight="600" prefHeight="600" maxHeight="600"
                  spacing="0" styleClass="auth-form-card, login-form-card">
                <padding><Insets top="24" right="32" bottom="20" left="32"/></padding>
                <Label text="登录账户" styleClass="auth-form-title"/>
                <Label text="欢迎回来，请登录你的本地账号" styleClass="auth-form-subtitle">
                    <VBox.margin><Insets top="6" bottom="16"/></VBox.margin>
                </Label>

                <Label text="用户名" styleClass="auth-field-label">
                    <VBox.margin><Insets bottom="6"/></VBox.margin>
                </Label>
                <StackPane styleClass="auth-input-wrap">
                    <TextField fx:id="usernameField" promptText="请输入用户名" onAction="#handleLogin"
                               styleClass="auth-input, auth-input-leading"/>
                    <FontIcon iconLiteral="mdi2a-account-outline" iconSize="22" mouseTransparent="true"
                              StackPane.alignment="CENTER_LEFT" styleClass="auth-input-icon">
                        <StackPane.margin><Insets left="16"/></StackPane.margin>
                    </FontIcon>
                </StackPane>

                <Label text="密码" styleClass="auth-field-label">
                    <VBox.margin><Insets top="16" bottom="5"/></VBox.margin>
                </Label>
                <StackPane styleClass="auth-input-wrap">
                    <PasswordField fx:id="passwordField" promptText="请输入密码" onAction="#handleLogin"
                                   styleClass="auth-input, auth-input-both"/>
                    <TextField fx:id="visiblePasswordField" promptText="请输入密码" onAction="#handleLogin"
                               visible="false" managed="false" styleClass="auth-input, auth-input-both"/>
                    <FontIcon iconLiteral="mdi2l-lock-outline" iconSize="22" mouseTransparent="true"
                              StackPane.alignment="CENTER_LEFT" styleClass="auth-input-icon">
                        <StackPane.margin><Insets left="16"/></StackPane.margin>
                    </FontIcon>
                    <Button fx:id="passwordVisibilityButton" onAction="#togglePasswordVisibility"
                            accessibleText="显示密码" StackPane.alignment="CENTER_RIGHT" styleClass="auth-eye-button">
                        <StackPane.margin><Insets right="8"/></StackPane.margin>
                        <graphic><FontIcon fx:id="passwordVisibilityIcon" iconLiteral="mdi2e-eye-off-outline" iconSize="21"/></graphic>
                    </Button>
                </StackPane>

                <HBox alignment="CENTER_LEFT" minHeight="40" prefHeight="40">
                    <CheckBox fx:id="rememberCheckBox" text="记住我" selected="true" styleClass="auth-checkbox"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="忘记密码？" onAction="#showPasswordHelp" styleClass="auth-link-button"/>
                </HBox>

                <Label fx:id="errorLabel" wrapText="true" maxWidth="Infinity" styleClass="form-error">
                    <VBox.margin><Insets bottom="8"/></VBox.margin>
                </Label>
                <Button fx:id="loginButton" text="登录" onAction="#handleLogin" defaultButton="true"
                        maxWidth="Infinity" minHeight="46" prefHeight="46" styleClass="auth-primary-button"/>

                <HBox alignment="CENTER" spacing="14" minHeight="44" prefHeight="44">
                    <Separator HBox.hgrow="ALWAYS"/>
                    <Label text="或" styleClass="auth-divider-text"/>
                    <Separator HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button fx:id="showRegisterButton" text="创建账号" onAction="#showRegister"
                        maxWidth="Infinity" minHeight="46" prefHeight="46"
                        contentDisplay="LEFT" graphicTextGap="10" styleClass="auth-secondary-button">
                    <graphic><FontIcon iconLiteral="mdi2a-account-plus-outline" iconSize="23"/></graphic>
                </Button>

                <HBox alignment="CENTER_LEFT" spacing="8" minHeight="40" prefHeight="40" styleClass="auth-card-note">
                    <FontIcon iconLiteral="mdi2i-information-outline" iconSize="19"/>
                    <Label text="使用本地账号登录，所有数据仅保存在本机。" styleClass="auth-card-note-text"/>
                </HBox>

                <HBox alignment="CENTER" minHeight="28" prefHeight="28" styleClass="auth-card-footer">
                    <padding><Insets top="14"/></padding>
                    <Label text="AI Interviewer   v1.0.0   |   本地 AI 技术面试助手" styleClass="auth-footer"/>
                </HBox>
            </VBox>
            <Region minWidth="36" prefWidth="36" maxWidth="160" HBox.hgrow="ALWAYS"/>
        </HBox>
    </center>
</BorderPane>
