<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <VBox spacing="22" styleClass="page-content">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <VBox spacing="8" styleClass="welcome-panel">
                <padding><Insets top="28" right="30" bottom="28" left="30"/></padding>
                <Label fx:id="greetingLabel" text="你好" styleClass="page-title"/>
                <Label text="准备开始一次专注、可恢复的 AI 模拟面试。" styleClass="hero-subtitle"/>
            </VBox>
            <HBox spacing="16">
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="账户与数据" styleClass="summary-label"/>
                    <Label text="本地存储已就绪" styleClass="summary-value"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="简历与方案" styleClass="summary-label"/>
                    <Label text="基础管理已启用" styleClass="summary-value"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="AI 服务" styleClass="summary-label"/>
                    <Label fx:id="aiDetailLabel" text="待配置" styleClass="summary-value"/>
                </VBox>
            </HBox>
            <VBox spacing="12" styleClass="content-card">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="本地数据与 AI 面试基础能力已就绪。" styleClass="content-description"/>
                <Separator/>
                <Label text="数据目录" styleClass="field-label"/>
                <Label fx:id="dataPathLabel" wrapText="true" styleClass="monospace-text"/>
                <Label text="上传简历、创建面试方案后，即可开始可暂停和恢复的模拟面试。"
                       styleClass="secondary-text" wrapText="true"/>
            </VBox>
            <VBox spacing="12" styleClass="content-card">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="后台任务" styleClass="module-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="刷新状态" onAction="#refreshTasks" styleClass="text-button"/>
                    <Button text="查看全部任务" onAction="#showAllTasks" styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="taskSummaryLabel" text="等待 0 · 执行中 0 · 失败 0" styleClass="summary-value"/>
                <Label fx:id="latestTaskLabel" text="暂无后台任务" wrapText="true" styleClass="secondary-text"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
