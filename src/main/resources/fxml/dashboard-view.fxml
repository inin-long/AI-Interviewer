<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll, dashboard-scroll">
    <content>
        <VBox spacing="14" styleClass="dashboard-page">
            <padding><Insets top="18" right="90" bottom="6" left="16"/></padding>

            <StackPane minHeight="104" prefHeight="104" maxHeight="104" styleClass="dashboard-hero-card">
                <VBox.margin><Insets right="32"/></VBox.margin>
                <ImageView fitWidth="570" fitHeight="112" preserveRatio="false" smooth="true" opacity="0.82"
                           StackPane.alignment="CENTER_RIGHT">
                    <image><Image url="@../images/home/dashboard-hero.png"/></image>
                </ImageView>
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <padding><Insets top="20" right="345" bottom="20" left="32"/></padding>
                    <VBox alignment="CENTER_LEFT" spacing="5" minWidth="300">
                        <Label fx:id="greetingLabel" text="晚上好，用户" styleClass="dashboard-greeting"/>
                        <Label text="准备开始一次新的 AI 模拟面试" styleClass="dashboard-hero-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="dashboardStartButton" text="开始面试" onAction="#startInterview" contentDisplay="LEFT" graphicTextGap="10"
                            minWidth="170" prefWidth="220" styleClass="hero-primary-button">
                        <graphic><FontIcon iconLiteral="mdi2p-play-outline" iconSize="22"/></graphic>
                    </Button>
                    <Button fx:id="dashboardCreatePlanButton" text="创建面试方案" onAction="#createPlan" contentDisplay="LEFT" graphicTextGap="10"
                            minWidth="190" prefWidth="230" styleClass="hero-secondary-button">
                        <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="22"/></graphic>
                    </Button>
                </HBox>
            </StackPane>

            <HBox spacing="14">
                <VBox.margin><Insets right="32"/></VBox.margin>
                <HBox minHeight="96" prefHeight="96" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="18"
                      HBox.hgrow="ALWAYS" styleClass="dashboard-summary-card">
                    <padding><Insets top="16" right="20" bottom="16" left="18"/></padding>
                    <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58" styleClass="summary-icon, summary-icon-blue">
                        <FontIcon iconLiteral="mdi2f-file-account-outline" iconSize="29"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label text="简历" styleClass="dashboard-summary-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="6">
                            <Label fx:id="resumeCountLabel" text="0" styleClass="dashboard-summary-value"/>
                            <Label text="份" styleClass="dashboard-summary-unit"/>
                        </HBox>
                        <Label fx:id="resumeHintLabel" text="本地安全存储" styleClass="dashboard-summary-hint"/>
                    </VBox>
                </HBox>
                <HBox minHeight="102" prefHeight="102" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="18"
                      HBox.hgrow="ALWAYS" styleClass="dashboard-summary-card">
                    <padding><Insets top="16" right="20" bottom="16" left="18"/></padding>
                    <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58" styleClass="summary-icon, summary-icon-purple">
                        <FontIcon iconLiteral="mdi2b-book-open-variant" iconSize="29"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label text="知识库" styleClass="dashboard-summary-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="6">
                            <Label fx:id="knowledgeCountLabel" text="0" styleClass="dashboard-summary-value"/>
                            <Label text="个文档" styleClass="dashboard-summary-unit"/>
                        </HBox>
                        <Label fx:id="knowledgeHintLabel" text="可用于面试追问" styleClass="dashboard-summary-hint"/>
                    </VBox>
                </HBox>
                <HBox minHeight="102" prefHeight="102" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="18"
                      HBox.hgrow="ALWAYS" styleClass="dashboard-summary-card">
                    <padding><Insets top="16" right="20" bottom="16" left="18"/></padding>
                    <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58" styleClass="summary-icon, summary-icon-green">
                        <FontIcon iconLiteral="mdi2p-play-circle-outline" iconSize="29"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label text="进行中面试" styleClass="dashboard-summary-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="6">
                            <Label fx:id="activeInterviewCountLabel" text="0" styleClass="dashboard-summary-value"/>
                            <Label text="个" styleClass="dashboard-summary-unit"/>
                        </HBox>
                        <Label fx:id="activeInterviewHintLabel" text="随时可继续" styleClass="dashboard-summary-hint"/>
                    </VBox>
                </HBox>
                <HBox minHeight="102" prefHeight="102" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="18"
                      HBox.hgrow="ALWAYS" styleClass="dashboard-summary-card">
                    <padding><Insets top="16" right="20" bottom="16" left="18"/></padding>
                    <StackPane minWidth="58" minHeight="58" maxWidth="58" maxHeight="58" styleClass="summary-icon, summary-icon-orange">
                        <FontIcon iconLiteral="mdi2t-trophy-outline" iconSize="29"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label text="最近得分" styleClass="dashboard-summary-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label fx:id="latestScoreLabel" text="--" styleClass="dashboard-summary-value, score-accent"/>
                            <Label text="/100" styleClass="dashboard-summary-unit"/>
                        </HBox>
                        <Label fx:id="latestScoreHintLabel" text="完成面试后生成" styleClass="dashboard-summary-hint"/>
                    </VBox>
                </HBox>
            </HBox>

            <GridPane hgap="0" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="63"/>
                    <ColumnConstraints percentWidth="34"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="296" prefHeight="296"/>
                    <RowConstraints minHeight="204" prefHeight="204"/>
                </rowConstraints>

                <VBox minHeight="296" prefHeight="296" maxHeight="296" styleClass="dashboard-panel"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <GridPane.margin><Insets right="20"/></GridPane.margin>
                    <HBox alignment="CENTER_LEFT" minHeight="48" prefHeight="48" styleClass="dashboard-panel-header">
                        <padding><Insets left="20" right="16"/></padding>
                        <Label text="最近面试" styleClass="dashboard-panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <VBox fx:id="recentInterviewList" spacing="10" VBox.vgrow="ALWAYS" styleClass="dashboard-list">
                        <padding><Insets top="0" right="16" bottom="8" left="16"/></padding>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" minHeight="38" prefHeight="38">
                        <padding><Insets right="12" bottom="6"/></padding>
                        <Button text="查看全部面试记录" onAction="#showHistory" contentDisplay="RIGHT" graphicTextGap="8"
                                styleClass="dashboard-link-button">
                            <graphic><FontIcon iconLiteral="mdi2a-arrow-right" iconSize="17"/></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <StackPane minHeight="204" prefHeight="204" styleClass="dashboard-panel, dashboard-score-panel"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <GridPane.margin><Insets right="16"/></GridPane.margin>
                    <ImageView fitWidth="500" fitHeight="200" preserveRatio="false" opacity="0.62"
                               StackPane.alignment="CENTER_RIGHT">
                        <image><Image url="@../images/home/dashboard-score.png"/></image>
                    </ImageView>
                    <VBox spacing="10">
                        <padding><Insets top="14" right="20" bottom="18" left="20"/></padding>
                        <Label text="最近一次面试结果" styleClass="dashboard-panel-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="32" VBox.vgrow="ALWAYS">
                            <StackPane minWidth="184" prefWidth="184">
                                <Circle radius="66" fill="TRANSPARENT" stroke="#E4E7F7" strokeWidth="7"/>
                                <Arc fx:id="scoreArc" radiusX="66" radiusY="66" startAngle="90" length="0"
                                     fill="TRANSPARENT" stroke="#5969F4" strokeWidth="7" strokeLineCap="ROUND"/>
                                <VBox alignment="CENTER" spacing="0">
                                    <Label fx:id="scoreValueLabel" text="--" styleClass="dashboard-score-value"/>
                                    <Label text="/100" styleClass="dashboard-score-unit"/>
                                </VBox>
                            </StackPane>
                            <VBox fx:id="dimensionList" spacing="9" minWidth="300" prefWidth="320"/>
                            <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="dashboard-score-copy">
                                <padding><Insets top="48"/></padding>
                                <Label text="综合评语" styleClass="dashboard-score-kicker"/>
                                <Label fx:id="scoreHeadlineLabel" text="完成一次面试后生成能力分析"
                                       wrapText="true" styleClass="dashboard-score-headline"/>
                                <Label fx:id="scoreSummaryLabel" text="系统会结合回答质量、项目经验和沟通表现给出结构化评估。"
                                       wrapText="true" maxWidth="360" styleClass="dashboard-score-summary"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>

                <VBox minHeight="296" prefHeight="296" maxHeight="296"
                      styleClass="dashboard-panel, dashboard-side-panel"
                      GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.valignment="TOP">
                    <GridPane.margin><Insets left="0" right="16"/></GridPane.margin>
                    <HBox alignment="CENTER_LEFT" minHeight="48" prefHeight="48" styleClass="dashboard-panel-header">
                        <padding><Insets left="20" right="16"/></padding>
                        <Label text="最近使用的面试方案" styleClass="dashboard-panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="查看全部" onAction="#showPlans" styleClass="dashboard-link-button"/>
                    </HBox>
                    <VBox fx:id="recentPlanList" spacing="0" VBox.vgrow="ALWAYS" styleClass="dashboard-plan-list">
                        <padding><Insets right="16" bottom="8" left="12"/></padding>
                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
