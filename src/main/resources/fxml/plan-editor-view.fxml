<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inin.aiinterviewer.ui.controller.InterviewPlanEditorController"
            styleClass="page-content">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="subpage-header">
            <padding><Insets top="20" right="28" bottom="18" left="28"/></padding>
            <Button text="←" onAction="#cancel" styleClass="back-icon-button"
                    accessibleText="返回面试方案列表">
                <tooltip><Tooltip text="返回面试方案列表"/></tooltip>
            </Button>
            <VBox spacing="4">
                <Label fx:id="pageHeadingLabel" text="新建面试方案" styleClass="page-title"/>
                <Label text="配置岗位、简历和规则，保存后返回方案列表" styleClass="secondary-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="取消" onAction="#cancel" styleClass="secondary-button"/>
            <Button fx:id="savePlanButton" text="保存方案" onAction="#savePlan" defaultButton="true" styleClass="primary-button"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <HBox spacing="20" styleClass="editor-page">
                    <padding><Insets top="20" right="28" bottom="28" left="28"/></padding>
                    <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="content-card">
                        <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                        <Label text="1  基础信息" styleClass="module-title"/>
                        <GridPane hgap="14" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="方案名称" styleClass="field-label"/>
                                <TextField fx:id="nameField" promptText="例如：Java 后端高级面试"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="目标岗位" styleClass="field-label"/>
                                <TextField fx:id="jobTitleField" promptText="例如：Java 后端工程师"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="难度" styleClass="field-label"/>
                                <ComboBox fx:id="difficultyBox" maxWidth="Infinity"/>
                            </VBox>
                            <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="时长（分钟）" styleClass="field-label"/>
                                    <TextField fx:id="durationField"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="题目数量" styleClass="field-label"/>
                                    <TextField fx:id="questionCountField"/>
                                </VBox>
                            </HBox>
                        </GridPane>
                        <Separator/>
                        <Label text="2  关联资料" styleClass="module-title"/>
                        <Label text="关联简历" styleClass="field-label"/>
                        <ComboBox fx:id="resumeBox" maxWidth="Infinity" promptText="不关联简历"/>
                        <Label text="已确认候选人画像" styleClass="field-label"/>
                        <ComboBox fx:id="profileBox" maxWidth="Infinity" promptText="不关联候选人画像"/>
                        <Label text="选择画像后会自动关联对应简历；未确认画像不会出现在这里。"
                               styleClass="secondary-text" wrapText="true"/>
                        <Label text="知识库分类（可多选）" styleClass="field-label"/>
                        <ListView fx:id="knowledgeList" prefHeight="150" minHeight="120"/>
                        <Label text="面试开始时会自动纳入所选分类下全部已就绪文档；按 Ctrl 或 Shift 可多选。"
                               styleClass="secondary-text" wrapText="true"/>
                        <Label text="岗位描述 / JD" styleClass="field-label"/>
                        <TextArea fx:id="jobDescriptionArea" promptText="粘贴岗位职责与要求" prefRowCount="7" wrapText="true"/>
                        <Separator/>
                        <Label text="3  面试规则" styleClass="module-title"/>
                        <Label text="岗位领域知识包" styleClass="field-label"/>
                        <ComboBox fx:id="domainPackBox" maxWidth="Infinity" promptText="请选择岗位知识包"/>
                        <Label text="知识包提供岗位能力模型、常见指标、事故模式、追问框架与评价标准。"
                               styleClass="secondary-text" wrapText="true"/>
                        <Label text="重点方向" styleClass="field-label"/>
                        <TextField fx:id="focusField" promptText="例如：Spring、数据库、项目深挖"/>
                        <GridPane hgap="14" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="面试模式" styleClass="field-label"/>
                                <ComboBox fx:id="modeBox" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="面试官角色" styleClass="field-label"/>
                                <ComboBox fx:id="personaBox" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="压力等级上限" styleClass="field-label"/>
                                <ComboBox fx:id="pressureBox" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="验证严格度" styleClass="field-label"/>
                                <ComboBox fx:id="strictnessBox" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                <Label text="情境沙盘题目比例" styleClass="field-label"/>
                                <ComboBox fx:id="scenarioRatioBox" maxWidth="Infinity"/>
                                <Label text="从 0%、20%、30% 或 50% 中选择；系统会使用当前知识包的内置岗位场景，并保证至少包含场景导入和一次决策后果。"
                                       styleClass="secondary-text" wrapText="true"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                    <VBox spacing="14" prefWidth="320" minWidth="300" styleClass="content-card">
                        <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                        <Label text="方案摘要" styleClass="module-title"/>
                        <Separator/>
                        <Label text="目标岗位" styleClass="summary-label"/>
                        <Label fx:id="summaryJobLabel" text="待填写" styleClass="summary-value" wrapText="true"/>
                        <Label text="难度" styleClass="summary-label"/>
                        <Label fx:id="summaryDifficultyLabel" text="中级" styleClass="summary-value"/>
                        <Label text="预计时长" styleClass="summary-label"/>
                        <Label fx:id="summaryDurationLabel" text="45 分钟" styleClass="summary-value"/>
                        <Label text="题目数量" styleClass="summary-label"/>
                        <Label fx:id="summaryQuestionsLabel" text="15 题" styleClass="summary-value"/>
                        <Label text="候选人画像" styleClass="summary-label"/>
                        <Label fx:id="summaryProfileLabel" text="未关联" styleClass="summary-value" wrapText="true"/>
                        <Label text="知识库分类" styleClass="summary-label"/>
                        <Label fx:id="summaryKnowledgeLabel" text="未选择" styleClass="summary-value"/>
                        <Label text="领域知识包" styleClass="summary-label"/>
                        <Label fx:id="summaryDomainPackLabel" text="待选择" styleClass="summary-value" wrapText="true"/>
                        <Label text="面试模式" styleClass="summary-label"/>
                        <Label fx:id="summaryModeLabel" text="正式模拟" styleClass="summary-value"/>
                        <Label text="压力等级" styleClass="summary-label"/>
                        <Label fx:id="summaryPressureLabel" text="标准" styleClass="summary-value"/>
                        <Label text="沙盘比例" styleClass="summary-label"/>
                        <Label fx:id="summaryScenarioRatioLabel" text="0%" styleClass="summary-value"/>
                        <Region prefHeight="8"/>
                        <Label text="保存方案后，可以从列表进入候选人画像和模拟面试准备流程。"
                               styleClass="local-data-note" wrapText="true"/>
                    </VBox>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
